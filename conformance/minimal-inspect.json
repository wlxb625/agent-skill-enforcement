{
  "package": "/mnt/data/agent-skill-enforcement-v0.2.0-draft/examples/minimal-enforced-skill",
  "enforcement": {
    "protocol": "ASEP",
    "spec_version": "0.2.0-draft",
    "kind": "enforced-agent-skill",
    "name": "evidence-brief",
    "version": "0.2.0",
    "description": "Minimal three-stage Enforced Skill example."
  },
  "compatibility": {
    "ordinary_skill": true,
    "fallback_mode": "soft-enforcement",
    "minimum_execution_level": "L1"
  },
  "state": {
    "controlled_by": "bundled-script",
    "start_stage": "draft",
    "storage": ".asep/state.json"
  },
  "stages": [
    {
      "id": "draft",
      "gates": [
        "draft-integrity"
      ],
      "output_schema": "schemas/draft.schema.json"
    },
    {
      "id": "review",
      "gates": [
        "evidence-quality"
      ],
      "output_schema": "schemas/review.schema.json"
    },
    {
      "id": "final",
      "gates": [],
      "output_schema": "schemas/final.schema.json"
    }
  ],
  "completion": {
    "terminal_stage": "COMPLETE",
    "receipt_schema": "schemas/completion-receipt.schema.json",
    "requires_stages": [
      "draft",
      "review",
      "final"
    ],
    "requires_gates": [
      "draft-integrity",
      "evidence-quality"
    ],
    "minimum_attestation": "self_assessed"
  }
}
