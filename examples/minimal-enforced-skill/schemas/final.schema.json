{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifact_id",
    "brief",
    "citations"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
