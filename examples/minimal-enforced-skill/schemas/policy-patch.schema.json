{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlxb625/agent-skill-enforcement/schemas/policy-patch.schema.json",
  "title": "Adaptive Policy Patch",
  "type": "object",
  "required": [
    "operation",
    "path",
    "scope",
    "evidence"
  ],
  "properties": {
    "operation": {
      "enum": [
        "add",
        "replace",
        "remove"
      ]
    },
    "path": {
      "type": "string"
    },
    "value": {},
    "scope": {
      "enum": [
        "user",
        "team",
        "project",
        "task"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "text"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
