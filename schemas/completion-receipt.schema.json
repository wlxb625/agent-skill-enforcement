{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-skills.dev/schemas/completion-receipt.schema.json",
  "title": "Contract Skill Completion Receipt",
  "type": "object",
  "required": [
    "contract",
    "task_id",
    "execution_level",
    "status",
    "completed_stages",
    "gate_results",
    "artifact_hashes",
    "attestation_summary",
    "timestamp"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version",
        "spec_version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "spec_version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "task_id": {
      "type": "string"
    },
    "execution_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "status": {
      "enum": [
        "CONTRACT_COMPLETE",
        "CONTRACT_FAILED",
        "CONTRACT_BLOCKED"
      ]
    },
    "completed_stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "CONDITIONAL",
          "FAIL",
          "NOT_APPLICABLE"
        ]
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "attestation_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
