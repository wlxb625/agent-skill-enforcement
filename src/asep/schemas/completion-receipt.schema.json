{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlxb625/agent-skill-enforcement/schemas/completion-receipt.schema.json",
  "title": "Enforced Skill Completion Receipt",
  "type": "object",
  "required": ["enforcement", "task_id", "execution_level", "status", "completed_stages", "gate_results", "artifact_hashes", "attestation_summary", "timestamp"],
  "properties": {
    "task_id": {"type": "string"},
    "execution_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "status": {"enum": ["ASEP_COMPLETE", "ASEP_FAILED", "ASEP_BLOCKED"]},
    "completed_stages": {"type": "array", "items": {"type": "string"}},
    "gate_results": {"type": "object", "additionalProperties": {"enum": ["PASS", "CONDITIONAL", "FAIL", "NOT_APPLICABLE"]}},
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "attestation_summary": {"type": "object", "additionalProperties": true},
    "timestamp": {"type": "string"},
    "enforcement": {
      "type": "object",
      "required": ["protocol", "name", "version", "spec_version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "spec_version": {"type": "string"},
        "protocol": {"const": "ASEP"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
